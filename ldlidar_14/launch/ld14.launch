<launch>
  <!-- 1. 发布base_link → laser的静态TF变换 -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="laser_tf_pub"
        args="0 0 0 0 0 0 base_link laser" output="screen" />
  <!-- 2. 启动LD14雷达节点 -->
  <node name="LD14" pkg="ldlidar_14" type="ldlidar" output="screen">
    <param name="port_name" value="/dev/ttyUSB0" />
    <param name="product" value="LD14" />
    <remap from="/LD14/LD14/LDLiDAR" to="/scan" />
  </node>
  <!-- 3. 启动hector_mapping（适配无里程计+标准/scan话题） -->
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="use_tf_odom_transform" value="false" />
    <param name="pub_map_odom_transform" value="false" />
    <param name="odom_frame" value="base_link" />
    <param name="base_frame" value="base_link" />
    <param name="map_frame" value="map" />
        <!-- 核心优化：降低距离阈值，让地图更新更灵敏（适配纯雷达） -->
    <param name="map_update_distance_threshold" value="0.1" /> 
    <!-- 增大角度阈值，避免快速旋转时丢数据（解决SearchDir报错+建图错位） -->
    <param name="map_update_angle_threshold" value="1.0" />  
    <!-- 适配LD14雷达：分辨率/测距范围（关键） -->
    <param name="map_resolution" value="0.03" />       <!-- 地图分辨率从0.05→0.03，更精细 -->
    <!-- 优化栅格更新权重：让障碍物更清晰，减少噪点 -->
    <param name="update_factor_free" value="0.3" />    <!-- 空闲区域权重降低，减少误标 -->
    <param name="update_factor_occupied" value="0.95" /> <!-- 障碍物权重提高，边缘更准 -->
    <!-- 降低发布频率，减少计算压力（纯雷达建图不用高频发布） -->
    <param name="map_pub_period" value="1.0" />
  </node>
    <!-- 4. 启动RViz（一键可视化建图） -->
  <node pkg="rviz" type="rviz" name="rviz" output="screen"
        args="-d $(find ldlidar_14)/rviz/lidar_LD14.rviz" />

</launch>
